#!/usr/bin/env bash
# 双击此文件 = 一键打开/关闭 A股因子研究服务
cd "$(dirname "$0")" || exit 1
clear
echo "================================================"
echo "   A股因子研究服务 · 一键开关"
echo "================================================"
./scripts/serve.sh toggle
echo ""
echo "================================================"
echo "按任意键关闭此窗口(可直接关掉)"
read -n 1 -s -r
